<% include ./partials/header.ejs %>
  <div class="w-full min-h-screen bg-zinc-900 text-white py-5 pl-[3.5vw] overflow-x-hidden">
    <div class="w-full px-4 flex items-center justify-between">
      
      <div class="icons -mt-2 flex justify-end items-center w-full">
       
        
        <img class="w-[10vw]" src="/images/sociafusion-high-resolution-logo-white-transparent.png" alt="">
      </div>
    </div>
     <h1 class="text-5xl font-light" >My  Following</h1>
    <div class="  flex  justify-between flex-col">
     <% user.following.reverse().forEach(function(singlefollower){ %>
      <div class="post mt-10 ">
        <div class="title px-4 flex items-center  gap-2">
        <a href="/profile/<%=singlefollower._id  %>" class="flex gap-1 items-center">
          <div class="w-[5vw] h-[5vw] min-w-[65px] min-h-[65px] bg-sky-100 rounded-full overflow-hidden">
            <img class="w-full h-full object-cover object-center" src="<%=singlefollower.profileImage.url  %>" alt="">
          </div>
          <h3>@<%=singlefollower.username  %></h3>
        </a>

        
          
        
        </div>
       
      </div>
   <%  }) %>
     
    </div>
  </div>
  <% include ./partials/footer.ejs %>