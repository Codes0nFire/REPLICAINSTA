<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Story Slider</title>
    <script src="https://cdn.tailwindcss.com"></script>
     
    <style>
        .story-slider {
            position: relative;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
        }
        .story-wrapper {
            
            display: flex;
            transition: transform 1s ease-in-out;
        }
        .story-item {
            flex: 0 0 100%;
            height: 100%;
           
        }
        .story-item img {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            max-width: 600px;
        }
       
    </style>
     
</head>
<body class="bg-gray-900 flex items-center justify-center h-screen w-screen">

    <div class="story-slider ">
        <div class="story-wrapper">
            <!-- Add your stories here -->

            <% user.story.forEach(function(elem){ %>

            <div class="story-item flex items-center justify-center ">
                <img src=" <%=elem.picture.url %>  " alt="Story 1" class="object-cover">
            </div>

           <% }) %>
            
            
        </div>
      
    </div>

    <script>
        const storyWrapper = document.querySelector('.story-wrapper');
        const stories = document.querySelectorAll('.story-item');
        let currentIndex = 0;
        
        function showNextStory() {
            currentIndex = (currentIndex + 1) % stories.length;
            const offset = -100 * currentIndex;
            storyWrapper.style.transform = `translateX(${offset}vw)`;
        }

        setInterval(showNextStory, 2500); // Change story every 5 seconds

        // Initialize first story
        showNextStory();


        setTimeout(() => {
        window.location.href = "/feed";
        },(stories.length)*4000); // 5000 milliseconds = 5 seconds
    </script>

</body>
</html>
