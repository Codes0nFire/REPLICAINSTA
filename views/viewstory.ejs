    <title>User Stories</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
        }

        .timer{
            animation: timer 5s linear 0s infinite;
        }
        @keyframes timer {
            0%{
                width:100vw;
            }

            100%{
                width: 0vw;
            }
            
        }
        
    </style>
</head>
<body class="  h-screen w-screen flex justify-center items-center">

    <!-- Story Container -->
    <div class="w-screen h-screen max-w-lg   shadow-md  overflow-hidden">
     

        <img src="<%=user.story[(user.story.length)-1]?.picture.url  %>" alt="" class="w-full h-full object-cover">

    
    </div>

    <div class="timer w-screen h-2 bg-black  absolute top-0 left-0">

    </div>

