<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SocialFusion</title>
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
   
    
</head>
<body class="flex bg-gray-900">
    <div class="flex flex-col h-screen w-96 bg-gray-900 text-white">
        <div class="flex items-center space-x-3 p-6">
            <img class="w-1/4" src="/images/sociafusion-high-resolution-logo-white-transparent.png" alt="">
            <p class="text-2xl leading-6">SocialFusion</p>
        </div>
        <nav class="flex flex-col mt-6">
            <a href="/feed" class="flex items-center space-x-4 p-4 hover:bg-gray-700 active text-gray-400 hover:text-white">
                <i class="fas fa-home text-xl"></i>
                <span>Home</span>
            </a>
            
          

           

            <a href="/edit" class="flex items-center space-x-4 p-4 hover:bg-gray-700 text-gray-400 hover:text-white">
                <i class="fas fa-edit"></i> 

                <span>Edit Profile</span>
            </a>

            <a href="/login" class="flex items-center space-x-4 p-4 hover:bg-gray-700 text-gray-400 hover:text-white">
                <i class="fas fa-sign-in-alt"></i>


                <span>Login with Another Account</span>
            </a>


            <a href="/logout" class="flex items-center space-x-4 p-4 hover:bg-gray-700 text-gray-400 hover:text-white">
                <i class="fas fa-sign-out-alt"></i>

                <span>Logout</span>
            </a>


            <a href="/deleteaccount" class="flex items-center space-x-4 p-4 hover:bg-gray-700 text-gray-400 hover:text-white">
                <i class="fas fa-trash-alt"></i>


                <span>Delete Account</span>
            </a>
        </nav>
    </div>
</body>
</html>
