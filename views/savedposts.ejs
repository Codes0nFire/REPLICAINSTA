<% include ./partials/header.ejs %>
  <div class="w-full min-h-screen bg-zinc-900 text-white py-5 overflow-x-hidden">
    <div class="w-full px-4 flex items-center justify-between">
      
      <div class="icons -mt-2 flex justify-end items-center w-full">
       
        
        <img class="w-1/6" src="/images/sociafusion-high-resolution-logo-white-transparent.png" alt="">
      </div>
    </div>
     <h1 class=" text-center text-2xl p-4">Saved Posts</h1>
    <div class="posts mb-20 flex justify-between gap-20 flex-wrap">
     <% user.saved.reverse().forEach(function(singlepost){ %>
      <div class="post mt-10  min-h-[50vh]">
        <div class="title px-4 flex items-center gap-2">
        <a href="/profile/<%=singlepost.user._id  %>" class="flex gap-1">
          <div class="w-[5vw] h-[5vw] bg-sky-100 rounded-full overflow-hidden">
            <img class="w-full h-full object-cover object-center" src="<%=singlepost.user.profileImage.url  %>" alt="">
          </div>
          <h4 class="text-sm"><%=singlepost.user.name  %></h4>
        </a>
          
          <h6 class="text-xs opacity-30">1d</h6>
        </div>
        <div class="w-96 h-96 mt-4 bg-sky-100">
          <img class="w-full h-full overflow-hidden object-cover " src="<%=singlepost.picture.url  %>" alt="">
        </div>
        <div class="options w-full px-4 flex justify-between items-center text-[1.4rem]">
          <div class="flex gap-3 mt-2">
            
            <a href="/like/<%=singlepost._id  %>">
              <i style=<%=singlepost.likes.indexOf(user._id) == -1 ? "color:white;" : "color:#e83e8c;" %> class=<%=singlepost.likes.indexOf(user._id) == -1 ? "ri-heart-3-line" : "ri-heart-3-fill" %>></i>
            </a>

            <a href="/save/<%=singlepost._id  %>">
                <i style=<%=user.saved.indexOf(singlepost._id) == -1 ? "color:#007bff;" : "color:white;" %> class=<%=user.saved.indexOf(singlepost._id) == -1 ? " ri-bookmark-fill" : "ri-bookmark-line" %>></i>
              </a>
            
           
          </div>
       
        </div>
        <h3 class="px-4 mt-2 text-sm leading-none tracking-tight"><%= singlepost.likes.length  %> likes</h3>
        <h2 class="text-white font-light text-sm mt-2"><span class="font-semibold pl-4 pr-2"><%=singlepost.user.username  %></span><%=singlepost.caption  %></h2>
      </div>
   <%  }) %>
     
    </div>
  </div>
  <% include ./partials/footer.ejs %>