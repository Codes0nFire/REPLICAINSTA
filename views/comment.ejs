<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SocialFusion</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.6.0/fonts/remixicon.css" rel="stylesheet">
</head>
<body class="bg-zinc-900 text-white p-5">

    <a class=" mb-4 text-lg text-white" href="/feed"><i class="ri-arrow-left-s-line"></i> Home</a>
    <h1 class="text-xl font-bold mb-4">Comments</h1>
<div class="flex flex-col justify-start h-[70vh]   overflow-y-auto">
    

   <% post.comments.forEach(function(comment){ %>

    <div class="mb-4">
        <div class="flex items-center mb-2 ">
            <img src="<%=comment.user.profileImage.url %>" alt="profile" class="rounded-full w-10 h-10 mr-3 object-cover">
            <div>
                <span class="font-bold text-blue-500"><%=comment.user.username %></span> 
            </div>
        </div>
        <p class="ml-13"><%=comment.text  %></p>
       
       
    </div>
   

  <% })  %>

    


   
</div>

<form class="mb-4 fixed " method="post" action="/addcomment/<%=post._id%>" >
    <input required name="text" type="text" placeholder="Add a comment..." class="  w-[90vw] bg-gray-800 rounded-full px-4 py-2 text-white">
    <input  class=" w-[30vw] bg-gray-800 rounded-full px-2 text-center py-2 text-white mt-2" type="submit" value="Comment">
</form>

</body>
</html>
