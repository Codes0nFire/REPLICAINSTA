<% include ./partials/header.ejs %>
  <div class="w-full min-h-screen bg-zinc-900 text-white py-5">
      <div class="nav flex justify-between items-center px-4">
        <h3 class="text-lg">@<%= profileuser.username  %></h3>
    
      </div>
      <div class="flex justify-between items-center pl-6 pr-[12vw] mt-8">
        <div class="w-[15vw] h-[15vw] bg-sky-100  rounded-full overflow-hidden flex 
        object-cover items-center justify-center">
          <img src="<%=profileuser.profileImage.url  %>" alt="">
        </div>
        <div class="stats flex gap-5 items-center justify-between">
          <div class="flex flex-col items-center justify-center">
            <h3><%= profileuser.posts.length  %></h3>
            <h4>Posts</h4>
          </div>
          <div class="flex flex-col items-center justify-center">
            <h3><%= profileuser.followers.length  %></h3>
            <h4>Followers</h4>
          </div>
          <div class="flex flex-col items-center justify-center">
            <h3><%= profileuser.following.length  %></h3>
            <h4>Following</h4>
          </div>
        </div>
      </div>
      <div class="dets px-6 mt-5">
        <h3 class="text-lg mb-1"><%= profileuser.name  %></h3>
        <p class="text-xs tracking-tight opacity-50">
          <%=profileuser.bio %>
        </p> 

       
      </div>
     <div class="mt-8">
        <a href="/follow/<%=profileuser._id  %>" class="px-3 py-2 bg-zinc-800 text-xs rounded-md ml-4 " >
            <%=profileuser.followers.indexOf(user.id) == -1 ? "Follow" : "Following"  %>
        </a>
     
     </div>
      <div class="posts w-full flex gap-1 py-2 mt-10 flex-wrap">
        <% if(profileuser.posts.length>0){ %>
          <% profileuser.posts.reverse().forEach(function(post){ %>
            <div class="post w-[45.5%] h-[50vh] bg-zinc-900">
              <img class="w-full h-full object-contain overflow-hidden object-center" src="<%= post.picture.url %>" alt=" find">
            </div>
          <% }) %>
        <% } else { %>
          <div class="w-full flex justify-center items-center min-h-[20vh]">
            <small class="opacity-50">no posts yet.</small>
          </div>
        <% } %>
      </div>
  </div>
<% include ./partials/footer.ejs %>